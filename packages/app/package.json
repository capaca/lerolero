{
	"name": "@lerolero/app",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:pseudo": "node scripts/pseudolingua.js && LINGUA_PSEUDO=1 BASE_PATH=/lerolero-pseudo vite build",
		"preview": "vite preview",
		"prepare": "paraglide-js compile --silent && svelte-kit sync || echo ''",
		"check": "paraglide-js compile --silent && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && svelte-check --tsconfig ./src/service-worker/tsconfig.json --threshold error",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@inlang/paraglide-js": "2.29.1",
		"@inlang/plugin-message-format": "4.5.0",
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.0.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/node": "24.19.1",
		"svelte": "5.57.2",
		"svelte-check": "4.7.6",
		"typescript": "6.0.3",
		"vite": "8.3.4"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"license": "AGPL-3.0-or-later",
	"dependencies": {
		"@lerolero/core": "workspace:*",
		"jsqr": "1.4.0",
		"uqr": "0.1.3"
	}
}
